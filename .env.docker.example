# Copy this file to .env in the repository root before starting Docker Compose.
# Use URL-safe characters in POSTGRES_PASSWORD (avoid @, :, /, ?, # and %).
POSTGRES_DB=partidechi_db
POSTGRES_USER=partidechi
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Optional PayPal Sandbox credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Ports exposed on your computer
FRONTEND_PORT=8080
BACKEND_PORT=4000
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:4000/api/v1
