// Prisma Schema - Partidechi ya!
// HU-01: Registro e inicio de sesion (tabla usuarios)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario        Int            @id @default(autoincrement())
  nombre            String         @db.VarChar(100)
  apellido          String         @db.VarChar(100)
  correo            String         @unique @db.VarChar(150)
  password_hash     String         @db.VarChar(255)
  rol               Rol            @default(JUGADOR)
  telefono          String?        @db.VarChar(30)
  estado            EstadoUsuario  @default(ACTIVO)
  puntaje_confiabilidad Int         @default(100)
  fecha_registro    DateTime       @default(now())
  canchas           Cancha[]
  reservas          Reserva[]
  pagosVerificados  Pago[]         @relation("PagosVerificados")
  partidosOrganizados Partido[]    @relation("PartidosOrganizados")
  participaciones   Participante[]
  notificaciones    Notificacion[]
  movimientosConfiabilidad MovimientoConfiabilidad[]
  movimientosConfiabilidadAdministrados MovimientoConfiabilidad[] @relation("AdministradoresConfiabilidad")
  reportesInasistenciaEnviados ReporteInasistencia[] @relation("ReportesEnviados")
  reportesInasistenciaRecibidos ReporteInasistencia[] @relation("ReportesRecibidos")
  reportesInasistenciaResueltos ReporteInasistencia[] @relation("ReportesResueltos")
  revisionesSolicitadas RevisionConfiabilidad[] @relation("RevisionesSolicitadas")
  revisionesResueltas RevisionConfiabilidad[] @relation("RevisionesResueltas")

  @@map("usuarios")
}

model Cancha {
  id_cancha         Int       @id @default(autoincrement())
  id_propietario    Int
  nombre            String    @db.VarChar(100)
  ubicacion         String    @db.VarChar(200)
  latitud           Float?
  longitud          Float?
  deporte           String    @db.VarChar(80)
  precio_hora       Float
  fecha_registro    DateTime  @default(now())
  propietario       Usuario   @relation(fields: [id_propietario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  horarios          Horario[]
  reservas          Reserva[]
  cierres           CierreCancha[]

  @@index([id_propietario])
  @@map("canchas")
}

/// Cierres puntuales de una cancha para una fecha, sin alterar sus horarios semanales.
model CierreCancha {
  id_cierre  Int      @id @default(autoincrement())
  id_cancha  Int
  fecha      DateTime @db.Date
  creado_en  DateTime @default(now())
  cancha     Cancha   @relation(fields: [id_cancha], references: [id_cancha], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id_cancha, fecha])
  @@index([fecha])
  @@map("cierres_canchas")
}

/// Avisos persistentes dirigidos a usuarios autenticados.
model Notificacion {
  id_notificacion Int      @id @default(autoincrement())
  id_usuario      Int
  titulo          String   @db.VarChar(150)
  mensaje         String   @db.VarChar(500)
  leida           Boolean  @default(false)
  fecha_creacion  DateTime @default(now())
  usuario         Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_usuario, leida, fecha_creacion])
  @@map("notificaciones")
}

/// Franjas horarias semanales registradas como disponibles para una cancha.
model Horario {
  id_horario  Int           @id @default(autoincrement())
  id_cancha   Int
  dia_semana  Int
  hora_inicio String        @db.VarChar(5)
  hora_fin    String        @db.VarChar(5)
  cancha      Cancha        @relation(fields: [id_cancha], references: [id_cancha], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_cancha, dia_semana])
  @@map("horarios")
}

/// Reservas de una cancha. Las reservas pendientes y confirmadas ocupan la
/// franja horaria y se excluyen de la disponibilidad publica.
model Reserva {
  id_reserva     Int           @id @default(autoincrement())
  id_usuario     Int
  id_cancha      Int
  fecha          DateTime      @db.Date
  hora_inicio    String        @db.VarChar(5)
  hora_fin       String        @db.VarChar(5)
  monto_total    Float
  estado         EstadoReserva @default(PENDIENTE)
  fecha_creacion DateTime      @default(now())
  usuario        Usuario       @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  cancha         Cancha        @relation(fields: [id_cancha], references: [id_cancha], onDelete: Cascade, onUpdate: Cascade)
  pagos          Pago[]
  partido        Partido?

  @@index([id_usuario])
  @@index([id_cancha, fecha])
  @@map("reservas")
}

/// Pagos asociados a una reserva.
model Pago {
  id_pago           Int         @id @default(autoincrement())
  id_reserva        Int
  monto             Float
  metodo_pago       String      @db.VarChar(40)
  referencia        String?     @db.VarChar(150)
  comprobante_url   String?     @db.VarChar(500)
  estado            EstadoPago  @default(PENDIENTE)
  verificado_por    Int?
  fecha_pago        DateTime    @default(now())
  fecha_verificacion DateTime?
  reserva           Reserva     @relation(fields: [id_reserva], references: [id_reserva], onDelete: Cascade, onUpdate: Cascade)
  verificador       Usuario?    @relation("PagosVerificados", fields: [verificado_por], references: [id_usuario], onDelete: SetNull, onUpdate: Cascade)

  @@index([id_reserva])
  @@map("pagos")
}

/// Estados de un pago.
enum EstadoPago {
  PENDIENTE  @map("pendiente")
  APROBADO   @map("aprobado")
  RECHAZADO  @map("rechazado")
  REEMBOLSADO @map("reembolsado")

  @@map("estado_pago")
}

/// Estados de una reserva. Las canceladas liberan la franja horaria.
enum EstadoReserva {
  PENDIENTE  @map("pendiente")
  CONFIRMADA @map("confirmada")
  CANCELADA  @map("cancelada")
  COMPLETADA @map("completada")

  @@map("estado_reserva")
}

/// Roles permitidos en el sistema: jugador, propietario, administrador
enum Rol {
  JUGADOR       @map("jugador")
  PROPIETARIO   @map("propietario")
  ADMINISTRADOR @map("administrador")

  @@map("rol")
}

/// Estados de cuenta de usuario
enum EstadoUsuario {
  ACTIVO     @map("activo")
  INACTIVO   @map("inactivo")
  SUSPENDIDO @map("suspendido")

  @@map("estado_usuario")
}

/// Partidos amistosos asociados a una reserva
model Partido {
  id_partido        Int           @id @default(autoincrement())
  id_organizador    Int
  id_reserva        Int?          @unique
  nombre            String        @db.VarChar(150)
  deporte           String        @db.VarChar(80)
  fecha_hora        DateTime
  jugadores_maximos Int?
  descripcion       String?       @db.VarChar(500)
  estado            EstadoPartido @default(PUBLICADO)
  organizador       Usuario       @relation("PartidosOrganizados", fields: [id_organizador], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  reserva           Reserva?      @relation(fields: [id_reserva], references: [id_reserva], onDelete: Restrict, onUpdate: Cascade)
  participantes     Participante[]
  reportesInasistencia ReporteInasistencia[]
  movimientosConfiabilidad MovimientoConfiabilidad[]

  @@index([id_organizador])
  @@index([id_reserva])
  @@map("partidos")
}

/// Participantes de un partido
model Participante {
  id_participante Int             @id @default(autoincrement())
  id_partido      Int
  id_usuario      Int
  estado          EstadoParticipante @default(ACEPTADO)
  fecha_union     DateTime         @default(now())
  partido         Partido          @relation(fields: [id_partido], references: [id_partido], onDelete: Cascade, onUpdate: Cascade)
  usuario         Usuario          @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id_partido, id_usuario])
  @@index([id_usuario])
  @@map("participantes")
}

enum EstadoPartido {
  PUBLICADO  @map("publicado")
  PRIVADO    @map("privado")
  CANCELADO  @map("cancelado")
  COMPLETADO @map("completado")

  @@map("estado_partido")
}

enum EstadoParticipante {
  ACEPTADO @map("aceptado")
  RECHAZADO @map("rechazado")
  ABANDONADO @map("abandonado")

  @@map("estado_participante")
}

model ReporteInasistencia {
  id_reporte       Int                    @id @default(autoincrement())
  id_partido       Int
  id_organizador   Int
  id_jugador       Int
  motivo           String                 @db.VarChar(500)
  estado           EstadoReporteInasistencia @default(PENDIENTE)
  fecha_reporte    DateTime               @default(now())
  fecha_decision   DateTime?
  decidido_por     Int?
  partido          Partido                @relation(fields: [id_partido], references: [id_partido], onDelete: Restrict, onUpdate: Cascade)
  organizador      Usuario                @relation("ReportesEnviados", fields: [id_organizador], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  jugador          Usuario                @relation("ReportesRecibidos", fields: [id_jugador], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  administrador    Usuario?               @relation("ReportesResueltos", fields: [decidido_por], references: [id_usuario], onDelete: SetNull, onUpdate: Cascade)
  movimiento       MovimientoConfiabilidad?

  @@unique([id_partido, id_jugador])
  @@index([estado, fecha_reporte])
  @@map("reportes_inasistencia")
}

model MovimientoConfiabilidad {
  id_movimiento       Int                     @id @default(autoincrement())
  id_usuario          Int
  id_partido          Int?
  id_reporte          Int?                    @unique
  id_movimiento_origen Int?                   @unique
  id_administrador    Int?
  tipo                TipoMovimientoConfiabilidad
  puntos_delta        Int
  puntaje_anterior    Int
  puntaje_resultante  Int
  motivo              String                  @db.VarChar(500)
  referencia_operacion String?                @db.VarChar(100)
  fecha_creacion      DateTime                @default(now())
  usuario             Usuario                 @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  administrador       Usuario?                @relation("AdministradoresConfiabilidad", fields: [id_administrador], references: [id_usuario], onDelete: SetNull, onUpdate: Cascade)
  partido             Partido?                @relation(fields: [id_partido], references: [id_partido], onDelete: SetNull, onUpdate: Cascade)
  reporte             ReporteInasistencia?    @relation(fields: [id_reporte], references: [id_reporte], onDelete: Restrict, onUpdate: Cascade)
  origen              MovimientoConfiabilidad? @relation("ReversionConfiabilidad", fields: [id_movimiento_origen], references: [id_movimiento], onDelete: Restrict, onUpdate: Cascade)
  reversion           MovimientoConfiabilidad? @relation("ReversionConfiabilidad")
  revisiones          RevisionConfiabilidad[]

  @@index([id_usuario, fecha_creacion])
  @@map("movimientos_confiabilidad")
}

model RevisionConfiabilidad {
  id_revision        Int                    @id @default(autoincrement())
  id_movimiento      Int
  id_solicitante     Int
  motivo             String                 @db.VarChar(500)
  estado             EstadoRevisionConfiabilidad @default(PENDIENTE)
  decision           String?                @db.VarChar(500)
  fecha_solicitud    DateTime               @default(now())
  fecha_decision     DateTime?
  decidido_por       Int?
  movimiento         MovimientoConfiabilidad @relation(fields: [id_movimiento], references: [id_movimiento], onDelete: Restrict, onUpdate: Cascade)
  solicitante        Usuario                @relation("RevisionesSolicitadas", fields: [id_solicitante], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  administrador      Usuario?               @relation("RevisionesResueltas", fields: [decidido_por], references: [id_usuario], onDelete: SetNull, onUpdate: Cascade)

  @@unique([id_movimiento, id_solicitante])
  @@index([estado, fecha_solicitud])
  @@map("revisiones_confiabilidad")
}

enum EstadoReporteInasistencia {
  PENDIENTE @map("pendiente")
  VALIDADO  @map("validado")
  RECHAZADO @map("rechazado")

  @@map("estado_reporte_inasistencia")
}

enum TipoMovimientoConfiabilidad {
  INASISTENCIA @map("inasistencia")
  CIERRE_CANCHA @map("cierre_cancha")
  CANCELACION_PARTIDO @map("cancelacion_partido")
  ABANDONO_PARTIDO @map("abandono_partido")
  AJUSTE_ADMIN @map("ajuste_admin")

  @@map("tipo_movimiento_confiabilidad")
}

enum EstadoRevisionConfiabilidad {
  PENDIENTE @map("pendiente")
  ACEPTADA  @map("aceptada")
  RECHAZADA @map("rechazada")

  @@map("estado_revision_confiabilidad")
}
