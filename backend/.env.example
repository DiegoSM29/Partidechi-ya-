PORT=4000
NODE_ENV=development
# Laragon/local PostgreSQL:
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/partidechi_db?schema=public"
# Supabase: reemplaza DATABASE_URL por el Session Pooler (puerto 5432).
# No uses el Transaction Pooler (puerto 6543) para este servidor Express persistente.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?schema=public"
JWT_SECRET="tu_secreto_jwt_super_seguro"
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10z
